# ===================================================================
# PredictSpace.AI - Backend Environment Variables (Template)
# Copy this file to .env and adjust variables as required
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (Default: H2 File Database)
DB_URL=jdbc:h2:file:./data/classroomdb;DB_CLOSE_DELAY=-1
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
H2_CONSOLE_ENABLED=true

# Hibernate / JPA
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Security & JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Prediction Configuration
PREDICTION_MIN_SAMPLE_SIZE=5
PREDICTION_WEIGHT_HISTORICAL=0.45
PREDICTION_WEIGHT_TIMETABLE=0.35
PREDICTION_WEIGHT_DAY_PATTERN=0.20
PREDICTION_MODEL_MODE=STATISTICAL_BASELINE

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
